# Copie para .env (cp ambiente.exemplo .env) e preencha. O .env está no .gitignore: nunca faça commit dele.
GROQ_API_KEY=
# Nome do DuckDNS (ex.: youaudit.duckdns.org): o Caddy gera HTTPS sozinho. Vazio = HTTP pelo IP.
DOMINIO=
# Limite de memória do Java. VM AMD de 1 GB: 768m. VM ARM (Ampere): pode subir para 1g ou mais.
LIMITE_MEMORIA=768m
